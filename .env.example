# Network / runtime
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
TZ=UTC
LOG_LEVEL=info

# Session / database
SESSION_SECRET=change-me
DB_URL=./data/erwin.sqlite
ERWIN_AUDIO_DIR=./data/audio

# Twitch OAuth app (required for Twitch login)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_CHANNEL=
# Optional explicit callback URL override (use if reverse proxy base URL causes mismatches)
TWITCH_REDIRECT_URI=

# Role mapping (optional)
# Comma-separated Twitch logins and/or Twitch user IDs
TWITCH_ADMINS=
TWITCH_CHANNEL_MEMBERS=
# Role name assigned to TWITCH_CHANNEL_MEMBERS entries
TWITCH_CHANNEL_MEMBERS_ROLE=channel_member

# Twitch bot / IRC integration (optional)
TWITCH_BOT_USERNAME=
TWITCH_OAUTH_TOKEN=
TWITCH_REFRESH_TOKEN=
TWITCH_COMMAND_PREFIX=!
TWITCH_IRC_HOST=raw-1.us-west-2.prod.twitchircedge.twitch.a2z.com

# yt-dlp / ffmpeg settings (optional)
ERWIN_YTDL_COOKIE_FILE=./data/youtube.cookie
ERWIN_YTDL_COOKIE=
ERWIN_YTDL_JS_RUNTIME=
ERWIN_YTDL_REMOTE_COMPONENTS=ejs:github
ERWIN_YTDL_FFMPEG_LOCATION=

# Download / retention controls (optional)
ERWIN_DOWNLOAD_CONCURRENCY=1
ERWIN_AUDIO_RETENTION_DAYS=7
ERWIN_AUDIO_RETENTION_MAX_GB=5
